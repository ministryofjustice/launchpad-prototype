+name: Security CodeQL actions scan
+
+on:
+  workflow_dispatch:
+  schedule:
+    - cron: "45 13 * * MON-FRI" # Every weekday at 13:45 UTC
+
+jobs:
+  security-codeql-actions-check:
+    permissions:
+      contents: read
+      actions: read
+      security-events: write
+    name: Project security CodeQL python scan
+    uses: ministryofjustice/hmpps-github-actions/.github/workflows/security_codeql_actions.yml@v2 # WORKFLOW_VERSION
+    with:
+      channel_id: ${{ vars.SECURITY_ALERTS_SLACK_CHANNEL_ID || 'NO_SLACK' }}
+    secrets: inherit
